{
  "name": "conveyor-engine-example",
  "version": "0.1.0",
  "private": true,
  "description": "Headless reference application for the Conveyor Engine vertical slice",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "start": "node dist/run.js",
    "start:arena": "node dist/run.js arena",
    "start:arena-wall": "node dist/run.js arena 40",
    "start:arena-miss": "node dist/run.js arena-miss",
    "run:lossless": "node dist/run.js lossless",
    "run:lossy": "node dist/run.js lossy",
    "run:partition": "node dist/run.js partition",
    "bench": "node dist/bench-cli.js",
    "viewer": "node viewer/serve.mjs",
    "record:arena": "node dist/arena-scenario.js",
    "live:arena": "node dist/arena-scenario.js live"
  },
  "license": "ISC",
  "dependencies": {
    "conveyor-engine-assets":  "^0.1.0",
    "conveyor-engine-client":  "^0.1.0",
    "conveyor-engine-core":  "^0.1.0",
    "conveyor-engine-replication":  "^0.1.0",
    "conveyor-engine-three":  "^0.1.0",
    "conveyor-engine-transport-ws":  "^0.1.0",
    "conveyor-engine-world":  "^0.1.0",
    "conveyor-graph":  "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.2"
  }
}
