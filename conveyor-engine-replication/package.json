{
  "name": "conveyor-engine-replication",
  "version": "0.0.1",
  "description": "Per-client replication scheduling for Conveyor Engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./simulator": {
      "types": "./dist/simulator.d.ts",
      "import": "./dist/simulator.js"
    }
  },
  "files": ["dist", "src"],
  "license": "ISC",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "conveyor-engine-core": "file:../conveyor-engine-core",
    "conveyor-engine-world": "file:../conveyor-engine-world"
  },
  "peerDependencies": {
    "conveyor-graph": ">=0.1.0",
    "conveyor-graph-simulator": ">=0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.2",
    "conveyor-graph": "file:../../conveyor-graph",
    "conveyor-graph-simulator": "file:../../conveyor-graph-simulator"
  }
}
